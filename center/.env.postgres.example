# PostgreSQL identity database. The host port is an immutable project contract.
POSTGRES_DB=lingframe_identity
POSTGRES_USER=lingframe_owner
POSTGRES_PASSWORD=replace_with_a_long_random_owner_password
APP_DB_USER=lingframe_app
APP_DB_PASSWORD=replace_with_a_different_long_random_app_password
LINGFRAME_DB_HOST=127.0.0.1
LINGFRAME_DB_PORT=5433
